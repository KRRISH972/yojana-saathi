# Copy this file to .env and fill in real values. Never commit .env.

# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Gemini model name used for answer generation
GEMINI_MODEL=gemini-3.5-flash-lite

# Local debugging only: set to 1 to make scripts/chat_cli.py print the raw
# profile_updates JSON Gemini returned each turn. Leave off otherwise.
YS_DEBUG_RAW=0
